      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/sync-logs?limit=5",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "sync-logs"
          ],
          "query": [
            {
              "key": "limit",
              "value": "5"
            }
          ]
        }
      }
