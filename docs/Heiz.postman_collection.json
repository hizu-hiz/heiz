    {
      "name": "Trigger sync (admin)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{adminToken}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/sync",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "sync"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"feeds\": [\n    \"gempaterkini\"\n  ]\n}"
        }
      }
