          "raw": "{{baseUrl}}/guide",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "guide"
          ]
        }
      }
    },
    {
      "name": "List earthquakes",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/earthquakes?limit=5",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "earthquakes"
          ],
          "query": [
            {
              "key": "limit",
              "value": "5"
            }
          ]
        }
      }
    },
    {
      "name": "List M>=5 BMKG",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/earthquakes?min_magnitude=5&source=BMKG",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "earthquakes"
          ],
          "query": [
            {
              "key": "min_magnitude",
              "value": "5"
            },
            {
              "key": "source",
              "value": "BMKG"
            }
          ]
        }
      }
    },
    {
      "name": "List invalid limit (400)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/earthquakes?limit=0",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "earthquakes"
          ],
          "query": [
            {
              "key": "limit",
              "value": "0"
            }
          ]
        }
      }
    },
    {
      "name": "Get earthquake (set id)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/earthquakes/1",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "earthquakes",
            "1"
          ]
        }
      }
    },
    {
      "name": "Get earthquake 404",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/earthquakes/999999999",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "earthquakes",
            "999999999"
          ]
        }
      }
    },
    {
      "name": "Create manual (201)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "X-API-Key",
            "value": "{{apiKey}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/earthquakes",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "earthquakes"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"location_description\": \"Test location, Bogor\",\n  \"latitude\": -6.69,\n  \"longitude\": 106.63,\n  \"magnitude\": 2.5,\n  \"depth_km\": 9,\n  \"occurred_at\": \"2026-10-16T03:21:55Z\"\n}"
        }
      }
    },
