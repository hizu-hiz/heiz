      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/",
          "host": [
            "{{baseUrl}}"
          ],
          "path": []
        }
      }
    },
    {
      "name": "Guide page",
      "request": {
        "method": "GET",
        "header": [],
