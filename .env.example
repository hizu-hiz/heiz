# Copy to .env for local use.
# Replace the placeholders; do not paste a real credential into this file.

DATABASE_URL=postgresql://postgres.<project-ref>:<YOUR-DB-PASSWORD>@<pooler-host>:6543/postgres

# Two different secrets, each at least 24 characters (shorter values are ignored and the feature stays off).
# Generate each with:  python -c "import secrets; print(secrets.token_urlsafe(32))"
# Writer key: header X-API-Key. Manual earthquake create/replace/update/delete only.
HEIZ_API_KEY=<generate-a-long-random-value>
# Admin token: header "Authorization: Bearer <token>". Sync, cleanup and the /dashboard. Keep it to yourself.
HEIZ_ADMIN_TOKEN=<generate-a-different-long-random-value>

# Optional overrides
# BMKG_BASE_URL=https://data.bmkg.go.id/DataMKG/TEWS/
# BMKG_TIMEOUT_SECONDS=10
# SYNC_MIN_INTERVAL_SECONDS=60

# Free-tier housekeeping (0 turns a rule off)
# RETENTION_RAW_PAYLOAD_DAYS=14
# RETENTION_EVENT_UPDATES_DAYS=90
# RETENTION_SYNC_LOGS_DAYS=30
# RETENTION_EVENTS_DAYS=365
# DB_QUOTA_MB=500
